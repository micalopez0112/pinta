# Copiá este archivo a .env si necesitás cambiar algo. Estos son los valores por defecto
# (los de desarrollo local).

# En producción, pegá la cadena de conexión de tu servicio de base de datos tal cual la entrega
# (Neon: usá la conexión directa, sin "pooler"). Puede empezar con postgresql:// o postgres://.
DATABASE_URL=postgresql+psycopg://pinta:pinta@localhost:5434/pinta

# Direcciones desde las que se permite usar la API, separadas por coma y SIN barra final.
# En producción: la dirección de tu web (por ejemplo https://pinta.pages.dev).
CORS_ORIGINS=http://localhost:5173

WEATHER_CACHE_SECONDS=600
